-- gop — экран UEFI через протокол прошивки GOP и задний буфер с дельтой.
-- Холст — graphics.Screen (рисуют по нему graphics.color / fill / blend). Задний
-- буфер — такой же холст в обычной памяти: всё рисуется в него, а present
-- копирует в видеопамять только изменившиеся куски строк (CopyMem прошивки).
-- Запись в видеопамять в разы дороже записи в ОЗУ, и экран не мигает. Буфер,
-- размеченный для блиттера видеокарты (intel_gpu), заливается и показывается
-- ею. Переехал из Saltic os/screen/graphics 22.11.2026.
--
-- open(base) -> Screen видеопамяти — средняя половина ширины; NoGraphics.
--     Левая четверть — сетевой журнал, правая — системная панель; программы
--     их не видят и рисуют от нуля
-- open_whole(base) -> Screen всего экрана: панели и снимок
-- side_width(width) -> ширина боковой панели из полной ширины
-- canvas_at(base, place, width, height, like) -> Screen в обычной памяти place
--     (stride = width, формат как у like) — рисовать панель без мерцания
-- put(base, canvas, whole, left) — холст на экран whole с колонки left
-- fill(screen, x, y, width, height, value) — у размеченного буфера от BIG
--     точек — блиттером видеокарты, иначе graphics.fill
-- Frames — front (видеопамять), back (рисовать сюда), last (что сейчас на экране)
-- open_frames(base) -> Frames; MemoryExhausted
-- present(frames) -> текст «строк N, пикселей M» — показать дельту; с
--     видеокартой — «видеокарта»: весь кадр одной командой блиттера
-- push(base, to, from) — задний буфер from на экран to целиком; с видеокартой
--     — после начала обратного хода луча (vsync)
-- copy_rect(base, to, from, x, y, width, height) — прямоугольник из from в
--     to: блиттером, если оба размечены (или to — экран GOP), иначе по
--     строкам (copy_span)
-- close_frames(frames) — вернуть буферы прошивке (перед выходом)
-- Буферы берутся в окне программы (uefi.pages_in_window): ниже базы их не видно.

use core.mem
use core.group
use core.num
use core.usize
use core.address
use registry.libraries.graphics
use registry.adapters.uefi_x86_64.firmware.firmware
use registry.adapters.uefi_x86_64.firmware.firmware.uefi
use registry.adapters.uefi_x86_64.intel_gpu.intel_gpu

BOOT_LOCATE_PROTOCOL = 320
GOP_GUID = [222, 169, 66, 144, 220, 35, 56, 74, 150, 251, 122, 222, 208, 128, 81, 106]
GOP_MODE = 24
MODE_INFO = 8
MODE_FRAME = 24
INFO_WIDTH = 4
INFO_HEIGHT = 8
INFO_FORMAT = 12
INFO_STRIDE = 32
BIG = 4096
PAGE_BYTES = 4096
BOOT_COPY_MEM = 352
SIDE_SHARE = 4

skill open(base) {
    @screen = open_whole(base)
    @left = side_width(screen.width)
    screen.frame = firmware.add(screen.frame, left * graphics.PIXEL_BYTES)
    screen.memory = firmware.guest(screen.frame, base)
    screen.width = screen.width - 2 * left
    out screen
}

skill side_width(width) {
    out width / SIDE_SHARE
}

skill canvas_at(base, place, width, height, like) {
    out graphics.Screen { width = width, height = height, stride = width, format = like.format, frame = place, memory = firmware.guest(place, base) }
}

skill put(base, source, whole, left) {
    @copy = firmware.pointer(uefi.boot_services(base), base, BOOT_COPY_MEM)
    @span = firmware.number(source.width * graphics.PIXEL_BYTES)
    drum (source.height) {
        firmware.call(base, copy, [firmware.add(whole.frame, (beat * whole.stride + left) * graphics.PIXEL_BYTES), firmware.add(source.frame, beat * source.stride * graphics.PIXEL_BYTES), span])
    }
    out none
}

skill open_whole(base) {
    @guid_at = firmware.scratch(base, 32)
    drum (16) { firmware.write8(guid_at, base, beat, group.get(GOP_GUID, beat)) }
    @found_at = firmware.scratch(base, 64)
    @services = uefi.boot_services(base)
    @located = firmware.call(base, firmware.pointer(services, base, BOOT_LOCATE_PROTOCOL), [guid_at, firmware.number(0), found_at])
    (located.failed == yes) { out error.NoGraphics }
    @protocol = firmware.pointer(found_at, base, 0)
    @mode = firmware.pointer(protocol, base, GOP_MODE)
    @info = firmware.pointer(mode, base, MODE_INFO)
    @frame = firmware.pointer(mode, base, MODE_FRAME)
    out graphics.Screen {
        width = firmware.read16(info, base, INFO_WIDTH),
        height = firmware.read16(info, base, INFO_HEIGHT),
        stride = firmware.read16(info, base, INFO_STRIDE),
        format = firmware.read16(info, base, INFO_FORMAT),
        frame = frame,
        memory = firmware.guest(frame, base)
    }
}

skill fill(screen, x0, y0, width0, height0, value) {
    @x = x0
    @y = y0
    @width = width0
    @height = height0
    (x < 0) {
        width = width + x
        x = 0
    }
    (y < 0) {
        height = height + y
        y = 0
    }
    (x + width > screen.width) { width = screen.width - x }
    (y + height > screen.height) { height = screen.height - y }
    (width <= 0) { out none }
    (height <= 0) { out none }
    (group.count(screen.accel) > 0) {
        (width * height >= BIG) {
            @gpu = group.get(screen.accel, 0)
            intel_gpu.fill(gpu, screen.frame, screen.stride * graphics.PIXEL_BYTES, x, y, width, height, value)
            out intel_gpu.wait(gpu)
        }
    }
    out graphics.fill(screen, x, y, width, height, value)
}

Frames = Box {
    front = graphics.Screen {},
    back = graphics.Screen {},
    last = graphics.Screen {},
    pages = 0
}

skill buffer_pages(front) {
    out (front.stride * front.height * graphics.PIXEL_BYTES + PAGE_BYTES - 1) / PAGE_BYTES
}

skill buffer_like(base, front) {
    @place = uefi.pages_in_window(base, buffer_pages(front))
    @accel = []
    @gpu = intel_gpu.open(base) rescue |err| { none }
    (gpu) |gpu| {
        @mapped = intel_gpu.map_identity(gpu, place, buffer_pages(front)) rescue |err| { -1 }
        (mapped == place) { accel = [gpu] }
    }
    out graphics.Screen { width = front.width, height = front.height, stride = front.stride, format = front.format, frame = place, memory = firmware.guest(place, base), accel = accel }
}

skill push(base, to, from) {
    (group.count(from.accel) > 0) {
        @gpu = group.get(from.accel, 0)
        (from.vsync == yes) { intel_gpu.wait_vblank(gpu) }
    }
    out copy_rect(base, to, from, 0, 0, from.width, from.height)
}

skill copy_rect(base, to, from, x, y, width, height) {
    (group.count(from.accel) == 0) {
        drum (height) { copy_span(base, to, from, y + beat, x, width) }
        out none
    }
    @gpu = group.get(from.accel, 0)
    @target = to.frame
    (group.count(to.accel) == 0) {
        (to.frame < gpu.aperture) {
            drum (height) { copy_span(base, to, from, y + beat, x, width) }
            out none
        }
        target = intel_gpu.screen_at(gpu, to.frame)
    }
    intel_gpu.copy(gpu, from.frame, target, to.stride * graphics.PIXEL_BYTES, x, y, width, height)
    out intel_gpu.wait(gpu)
}

skill copy_span(base, to, from, y, left, count) {
    @offset = (y * to.stride + left) * graphics.PIXEL_BYTES
    @copy = firmware.pointer(uefi.boot_services(base), base, BOOT_COPY_MEM)
    out firmware.call(base, copy, [firmware.add(to.frame, offset), firmware.add(from.frame, offset), firmware.number(count * graphics.PIXEL_BYTES)])
}

skill open_frames(base) {
    @front = open(base)
    @frames = Frames { front = front, back = buffer_like(base, front), last = buffer_like(base, front), pages = buffer_pages(front) }
    drum (front.height) { copy_span(base, frames.last, front, beat, 0, front.width) }
    drum (front.height) { copy_span(base, frames.back, front, beat, 0, front.width) }
    out frames
}

skill present(frames) {
    @base = firmware.guest_base()
    @back = frames.back
    (group.count(back.accel) > 0) {
        push(base, frames.front, back)
        out "видеокарта"
    }
    @last = frames.last
    @rows = 0
    @pixels = 0
    drum (back.height) {
        @y = beat
        @start = y * back.stride * graphics.PIXEL_BYTES
        @first = -1
        @final = -1
        drum (back.width) {
            @at = start + beat * graphics.PIXEL_BYTES
            ((num.from(mem.load32(address.from(back.memory), usize.from(at))) == num.from(mem.load32(address.from(last.memory), usize.from(at)))) == no) {
                (first < 0) { first = beat }
                final = beat
            }
        }
        (first > -1) {
            @count = final - first + 1
            copy_span(base, frames.front, back, y, first, count)
            copy_span(base, last, back, y, first, count)
            rows = rows + 1
            pixels = pixels + count
        }
    }
    out "строк {rows}, пикселей {pixels}"
}

skill close_frames(frames) {
    @base = firmware.guest_base()
    uefi.free_pages(base, frames.back.frame, frames.pages)
    out uefi.free_pages(base, frames.last.frame, frames.pages)
}

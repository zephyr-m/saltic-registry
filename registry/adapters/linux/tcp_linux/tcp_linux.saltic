-- tcp_linux — МОСТ к TCP ядра Linux, не свой TCP: соединение по IPv4 через
-- сокеты хоста (core.socket), всю работу TCP (номера, подтверждения, повторы)
-- делает Linux. Свой TCP на Saltic — библиотека tcp. Причина сбоя — в имени
-- ошибки (ConnectionRefused, NetworkUnreachable, ConnectionReset…).
-- Пока ждёт без предела: у сокетов языка нет таймаутов (нужен родной poll или
-- setsockopt в core.socket); запись в закрытое собеседником соединение роняет
-- программу сигналом SIGPIPE (нужен send с MSG_NOSIGNAL) — оба пункта в паспорте.
--
-- Link { fd, open } — открытое соединение:
--     send(data) — отправить буфер core.bytes целиком (дописывает, пока не уйдёт всё)
--     receive(limit) -> буфер до limit байтов; собеседник закрыл — ConnectionClosed
--     close() — закрыть; дальше send / receive — SocketClosed
--     Сбои связи — ошибками core.socket с причиной: ConnectionReset,
--     ConnectionClosed, ConnectionTimedOut, прочее — Socket
-- connect(address, port) -> Link; address — «a.b.c.d»; BadAddress, BadPort,
--     ConnectionRefused, NetworkUnreachable, HostUnreachable, ConnectionTimedOut,
--     Socket; при отказе сокет закрывается
-- sockaddr(address, port) -> 16 байтов sockaddr_in; BadAddress, BadPort
-- octets(address) -> группа из 4 чисел 0…255; BadAddress
-- AF_INET — семейство IPv4; SOCK_STREAM — поток

use core.str
use core.num
use core.bytes
use core.group
use core.socket

AF_INET = 2
SOCK_STREAM = 1
SOCKADDR_BYTES = 16
PORT_MOST = 65535
OCTET_MOST = 255

Link = Box {
    fd = -1,
    open = no

    skill send(data) {
        (open == no) {
            out error.SocketClosed
        }
        @total = bytes.count(data)
        @sent = 0
        drum (total + 1) {
            (sent >= total) {
                leave
            }
            @rest = bytes.slice(data, sent, total)
            @written = socket.write(fd, rest, bytes.count(rest))
            sent = sent + written
        }
        out none
    }

    skill receive(limit) {
        (open == no) {
            out error.SocketClosed
        }
        @buffer = bytes.new(limit)
        @got = socket.read(fd, buffer)
        out bytes.slice(buffer, 0, got)
    }

    skill close() {
        (open == no) {
            out error.SocketClosed
        }
        socket.close(fd)
        open = no
        out none
    }
}

skill octets(address) {
    @parts = str.split(address, ".")
    ((group.count(parts) == 4) == no) {
        out error.BadAddress
    }
    @found = []
    drum (group.count(parts)) {
        @part = group.get(parts, beat)
        ((str.bytes(part) > 3) ○○ (str.bytes(part) == 0)) {
            out error.BadAddress
        }
        @value = 0
        drum (str.bytes(part)) {
            @digit = str.get(part, beat)
            (str.is_digit(digit) == no) {
                out error.BadAddress
            }
            value = value * 10 + num.digit_value(digit)
        }
        (value > OCTET_MOST) {
            out error.BadAddress
        }
        found = group.add(found, value)
    }
    out found
}

skill sockaddr(address, port) {
    ((port < 1) ○○ (port > PORT_MOST)) {
        out error.BadPort
    }
    @four = octets(address)
    @made = bytes.new(SOCKADDR_BYTES)
    bytes.set(made, 0, AF_INET)
    bytes.set(made, 2, port / 256)
    bytes.set(made, 3, port % 256)
    drum (4) {
        bytes.set(made, 4 + beat, group.get(four, beat))
    }
    out made
}

skill connect(address, port) {
    @place = sockaddr(address, port)
    @fd = socket.open(AF_INET, SOCK_STREAM, 0)
    @answer = socket.connect(fd, place) rescue |err| {
        @closed = socket.close(fd) rescue |again| { none }
        out err
    }
    out Link {
        fd = fd,
        open = yes
    }
}

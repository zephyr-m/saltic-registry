-- mantis — проверка богомола им же самим: учебный экзамен trial с двумя
-- сданными и двумя проваленными проверками — счётчики, провалы с именем,
-- фактом и ожиданием, done() поднимает TestsFailed; пустой экзамен done()
-- проходит; scratch без SALTIC_SCRATCH кладёт файл в .cache/build/tests.
-- Строки «[FAIL]» учебного экзамена в выводе — нарочно.
--
-- program() -> none; TestsFailed

use core.group
use registry.libraries.mantis.mantis

program() {
    @exam = mantis.Exam {}
    @trial = mantis.Exam {}
    trial.equal("учебная: два и два", 2 + 2, 4)
    trial.confirms("учебная: yes", yes)
    trial.equal("учебная: нарочно мимо", 3, 4)
    trial.denies("учебная: нарочно yes", yes)
    exam.equal("сдано", trial.passed, 2)
    exam.equal("провалено", trial.failed, 2)
    @first = trial.failures
    exam.equal("провалов записано", group.count(first), 2)
    @miss = group.get(first, 0)
    exam.equal("провал: имя", miss.name, "учебная: нарочно мимо")
    exam.equal("провал: факт", miss.actual, 3)
    exam.equal("провал: ожидание", miss.expected, 4)
    @verdict = trial.done() rescue |err| { err }
    exam.confirms("с провалами done — TestsFailed", (verdict == error.TestsFailed))
    @calm = mantis.Exam {}
    exam.equal("пустой экзамен проходит", calm.done(), none)
    exam.equal("scratch без SALTIC_SCRATCH", exam.scratch("a.txt"), ".cache/build/tests/a.txt")
    out exam.done()
}

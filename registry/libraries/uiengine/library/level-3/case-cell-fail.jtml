{
  "component": {
    "name": "case-cell-fail",
    "params": [
      "id",
      "name",
      "time"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "width": 162,
        "gap": 0,
        "children": [
          {
            "cell": {
              "fill": "down_soft",
              "edge": "down_rim",
              "border": 1,
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "gap": 8,
                    "align": "center",
                    "padding": [
                      7,
                      9,
                      7,
                      9
                    ],
                    "children": [
                      {
                        "spinner-fail": {}
                      },
                      {
                        "mono-cut": {
                          "text": "{name}",
                          "tone": "ink",
                          "size": 12
                        }
                      },
                      {
                        "console-line": {
                          "text": "{time}",
                          "tone": "down",
                          "size": 11
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
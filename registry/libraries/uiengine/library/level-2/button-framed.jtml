{
  "component": {
    "name": "button-framed",
    "params": [
      "id",
      "text"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "flow": "row",
        "fill": "raise",
        "edge": "line",
        "border": 1,
        "radius": 9,
        "padding": [
          8,
          14,
          8,
          14
        ],
        "gap": 0,
        "justify": "center",
        "children": [
          {
            "text": {
              "value": "{text}",
              "size": 13,
              "tone": "ink",
              "weight": "regular"
            }
          }
        ]
      }
    }
  }
}
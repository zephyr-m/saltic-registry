-- adam — оптимизатор Adam (Кингма и Ба, 2014): средние градиента m и его
-- квадрата s с поправкой смещения на шаге t, шаг θ − rate · m̂ / (√ŝ + epsilon).
-- Параметры и градиенты — группы дробных одной длины; состояние — в Box.
--
-- Adam { rate, first, second, epsilon, moment, square, count, power_first,
--     power_second } — step(params, grads) -> новые параметры
--     part(a, i) -> дробное

use core.group
use core.fraction

Adam = Box {
    rate = 0.001,
    first = 0.9,
    second = 0.999,
    epsilon = 0.00000001,
    moment = [],
    square = [],
    count = 0,
    power_first = 1.0,
    power_second = 1.0

    skill part(a, i) {
        out 0.0 + group.get(a, i)
    }

    skill step(params, grads) {
        (group.count(moment) == 0) {
            drum (group.count(params)) {
                moment = group.add(moment, 0.0)
                square = group.add(square, 0.0)
            }
        }
        count = count + 1
        power_first = power_first * first
        power_second = power_second * second
        @moments = []
        @squares = []
        @moved = []
        drum (group.count(params)) {
            @g = part(grads, beat)
            @m = first * part(moment, beat) + (1.0 - first) * g
            @s = second * part(square, beat) + (1.0 - second) * g * g
            moments = group.add(moments, m)
            squares = group.add(squares, s)
            @fixed_m = m / (1.0 - power_first)
            @fixed_s = s / (1.0 - power_second)
            moved = group.add(moved, part(params, beat) - rate * fixed_m / (fraction.sqrt(fixed_s) + epsilon))
        }
        moment = moments
        square = squares
        out moved
    }
}

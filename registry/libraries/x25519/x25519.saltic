-- x25519 — обмен ключами X25519 (RFC 7748): лестница Монтгомери на кривой
-- Curve25519, поле по модулю p = 2^255 − 19 — жилец field (общий с ed25519).
-- Секрет, открытый ключ и общий секрет — 32 байта младшим вперёд.
-- Не за постоянное время: от атак по времени не защищён.
--
-- X25519 { space, math } — space — field.Field (поле по модулю p), math —
--     magnitude.Magnitude
--     public_of(secret) -> открытый ключ: секрет · точка 9
--     shared(secret, peer) -> общий секрет; WeakKey, если вышел ноль
--     multiply(scalar, point) -> scalar · point (оба по 32 байта)
-- A24 — (486662 − 2) / 4; WeakKey — общий секрет вышел нулём

use core.num
use core.bytes
use core.group
use registry.libraries.bignum.magnitude
use registry.libraries.x25519.field

A24 = 121665

X25519 = Box {
    space = field.Field {},
    math = magnitude.Magnitude {}

    skill multiply(scalar, point) {
        @k = bytes.slice(scalar, 0, 32)
        bytes.set(k, 0, num.and(bytes.get(k, 0), 248))
        bytes.set(k, 31, num.or(num.and(bytes.get(k, 31), 127), 64))
        @u = bytes.slice(point, 0, 32)
        bytes.set(u, 31, num.and(bytes.get(u, 31), 127))
        @x1 = space.reduced(space.number(u, 0))
        @x2 = math.of(1)
        @z2 = []
        @x3 = x1
        @z3 = math.of(1)
        @swap = 0
        @scalar_bits = space.number(k, 0)
        drum (255) {
            @t = 254 - beat
            @bit = math.bit(scalar_bits, t)
            (num.xor(swap, bit) == 1) {
                @kept_x = x2
                @kept_z = z2
                x2 = x3
                z2 = z3
                x3 = kept_x
                z3 = kept_z
            }
            swap = bit
            @a = space.add(x2, z2)
            @aa = space.mul(a, a)
            @b = space.sub(x2, z2)
            @bb = space.mul(b, b)
            @e = space.sub(aa, bb)
            @c = space.add(x3, z3)
            @d = space.sub(x3, z3)
            @da = space.mul(d, a)
            @cb = space.mul(c, b)
            @plus = space.add(da, cb)
            @minus = space.sub(da, cb)
            x3 = space.mul(plus, plus)
            z3 = space.mul(x1, space.mul(minus, minus))
            x2 = space.mul(aa, bb)
            z2 = space.mul(e, space.add(aa, space.mul(math.of(A24), e)))
        }
        (swap == 1) {
            x2 = x3
            z2 = z3
        }
        out space.bytes_of(space.mul(x2, space.inverse(z2)))
    }

    skill public_of(secret) {
        @base = bytes.new(32)
        bytes.set(base, 0, 9)
        out multiply(secret, base)
    }

    skill shared(secret, peer) {
        @made = multiply(secret, peer)
        @any = 0
        drum (32) {
            any = num.or(any, bytes.get(made, beat))
        }
        (any == 0) {
            out error.WeakKey
        }
        out made
    }
}

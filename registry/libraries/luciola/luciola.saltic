-- luciola — светлячок: движок движения программ (MotionEngine) — как экран
-- меняется во времени, поверх UIEngine (Attacus), который знает только «что и
-- где» (решение автора 18.11.2026). Первая версия — заготовка: имя и кривая
-- пружины из языка вида (docs/design/LANGUAGE.md, «Движение»); сам движок ждёт
-- частичной перерисовки и часов на ядре событий.
--
-- SPRING — пружина cubic-bezier(.34, 1.56, .64, 1): [x1, y1, x2, y2] — появление
--     (масштаб 0.9 → 1), наведение (подъём на 1–3 px), выдвижная панель
-- QUIET — тема «Тихо»: ничего не движется само (yes)

SPRING = [0.34, 1.56, 0.64, 1.0]
QUIET = yes

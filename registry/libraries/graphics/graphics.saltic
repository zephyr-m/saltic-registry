-- graphics — холст: 32-битные точки в памяти, адрес точки — (y * stride + x) * 4
-- от memory. Рисует только процессор, о железе и прошивке не знает: холст
-- открывает тот, кто даёт память (gop на UEFI, Wayland на Linux, поверхность
-- на Android), а рисуют по нему все одинаково. Ускорение видеокартой — у
-- того, кто холст открыл (gop.fill для буфера, размеченного для блиттера).
-- Переехал из Saltic os/screen/graphics 22.11.2026.
--
-- Screen — ширина, высота, stride, формат, frame (адрес), memory (для core.mem),
--     accel — [видеокарта] у буфера, размеченного для её блиттера, иначе [];
--     vsync — показывать ли кадр по обратному ходу луча (смысл — у gop)
-- FORMAT_RGB / FORMAT_BGR — порядок каналов; PIXEL_BYTES — байт на точку
-- color(screen, red, green, blue) -> пиксель
-- fill(screen, x, y, width, height, value) — прямоугольник, обрезанный по краям холста
-- blend(screen, x, y, width, height, value, alpha) — то же полупрозрачно: alpha 0…255
-- mix(under, over, alpha) -> точка: over поверх under, каждый канал отдельно
-- canvas_dot(screen, x, y, value, alpha) — одна точка; за краем холста — ничего
-- canvas_line(screen, x0, y0, x1, y1, value, alpha) — отрезок по Брезенхему, оба конца
-- canvas_polygon(screen, points, value, alpha) — залитый многоугольник, points — [[x, y], …];
--     точка закрашена, если её центр внутри (левый край включён, правый нет),
--     внутри — по правилу чёт-нечет
-- canvas_edges(points, y) -> первые точки справа от рёбер на строке y, по возрастанию;
--     ceiling_of(top, under) -> ⌈top / under⌉ при under > 0 — внутри polygon
-- format_name(screen) -> текст

use core.mem
use core.num
use core.group
use core.usize
use core.address
use core.u32

FORMAT_RGB = 0
FORMAT_BGR = 1
PIXEL_BYTES = 4

Screen = Box {
    width = 0,
    height = 0,
    stride = 0,
    format = 0,
    frame = 0,
    memory = 0,
    accel = [],
    vsync = yes
}

skill color(screen, red, green, blue) {
    (screen.format == FORMAT_RGB) { out blue * 65536 + green * 256 + red }
    out red * 65536 + green * 256 + blue
}

skill mix(under, over, alpha) {
    @back = 255 - alpha
    @blue = (over % 256 * alpha + under % 256 * back) / 255
    @green = (over / 256 % 256 * alpha + under / 256 % 256 * back) / 255
    @red = (over / 65536 % 256 * alpha + under / 65536 % 256 * back) / 255
    out red * 65536 + green * 256 + blue
}

skill blend(screen, x0, y0, width0, height0, value, alpha) {
    (alpha >= 255) { out fill(screen, x0, y0, width0, height0, value) }
    (alpha <= 0) { out none }
    @x = x0
    @y = y0
    @width = width0
    @height = height0
    (x < 0) {
        width = width + x
        x = 0
    }
    (y < 0) {
        height = height + y
        y = 0
    }
    (x + width > screen.width) { width = screen.width - x }
    (y + height > screen.height) { height = screen.height - y }
    (width <= 0) { out none }
    (height <= 0) { out none }
    @base = address.from(screen.memory)
    @back = 255 - alpha
    @blue = value % 256 * alpha
    @green = value / 256 % 256 * alpha
    @red = value / 65536 % 256 * alpha
    drum (height) {
        @row = ((y + beat) * screen.stride + x) * PIXEL_BYTES
        drum (width) {
            @at = usize.from(row + beat * PIXEL_BYTES)
            @under = num.from(mem.load32(base, at))
            @b = (blue + under % 256 * back) / 255
            @g = (green + under / 256 % 256 * back) / 255
            @r = (red + under / 65536 % 256 * back) / 255
            mem.store32(base, at, u32.from(r * 65536 + g * 256 + b))
        }
    }
    out none
}

skill fill(screen, x0, y0, width0, height0, value) {
    @x = x0
    @y = y0
    @width = width0
    @height = height0
    (x < 0) {
        width = width + x
        x = 0
    }
    (y < 0) {
        height = height + y
        y = 0
    }
    (x + width > screen.width) { width = screen.width - x }
    (y + height > screen.height) { height = screen.height - y }
    (width <= 0) { out none }
    (height <= 0) { out none }
    @base = address.from(screen.memory)
    @point = u32.from(value)
    drum (height) {
        @row = ((y + beat) * screen.stride + x) * PIXEL_BYTES
        drum (width) { mem.store32(base, usize.from(row + beat * PIXEL_BYTES), point) }
    }
    out none
}

skill canvas_dot(screen, x, y, value, alpha) {
    ((x < 0) ○○ (y < 0)) {
        out none
    }
    ((x >= screen.width) ○○ (y >= screen.height)) {
        out none
    }
    @at = usize.from((y * screen.stride + x) * PIXEL_BYTES)
    (alpha >= 255) {
        mem.store32(address.from(screen.memory), at, u32.from(value))
        out none
    }
    @under = num.from(mem.load32(address.from(screen.memory), at))
    mem.store32(address.from(screen.memory), at, u32.from(mix(under, value, alpha)))
    out none
}

skill canvas_line(screen, x0, y0, x1, y1, value, alpha) {
    (alpha <= 0) {
        out none
    }
    ((x0 < 0) ○ (x1 < 0)) {
        out none
    }
    ((y0 < 0) ○ (y1 < 0)) {
        out none
    }
    ((x0 >= screen.width) ○ (x1 >= screen.width)) {
        out none
    }
    ((y0 >= screen.height) ○ (y1 >= screen.height)) {
        out none
    }
    @dx = x1 - x0
    @step_x = 1
    (dx < 0) {
        dx = 0 - dx
        step_x = -1
    }
    @dy = y1 - y0
    @step_y = 1
    (dy < 0) {
        dy = 0 - dy
        step_y = -1
    }
    @count = dx + 1
    (dy > dx) {
        count = dy + 1
    }
    @x = x0
    @y = y0
    @error = dx - dy
    @base = address.from(screen.memory)
    @solid = (alpha >= 255)
    @point = u32.from(value)
    @back = 255 - alpha
    @blue = value % 256 * alpha
    @green = value / 256 % 256 * alpha
    @red = value / 65536 % 256 * alpha
    drum (count) {
        @inside = (((x >= 0) ○ (y >= 0)) ○ ((x < screen.width) ○ (y < screen.height)))
        ((inside == yes) ○ (solid == yes)) {
            mem.store32(base, usize.from((y * screen.stride + x) * PIXEL_BYTES), point)
        }
        ((inside == yes) ○ (solid == no)) {
            @at = usize.from((y * screen.stride + x) * PIXEL_BYTES)
            @under = num.from(mem.load32(base, at))
            @b = (blue + under % 256 * back) / 255
            @g = (green + under / 256 % 256 * back) / 255
            @r = (red + under / 65536 % 256 * back) / 255
            mem.store32(base, at, u32.from(r * 65536 + g * 256 + b))
        }
        @twice = error * 2
        (twice > 0 - dy) {
            error = error - dy
            x = x + step_x
        }
        (twice < dx) {
            error = error + dx
            y = y + step_y
        }
    }
    out none
}

skill canvas_edges(points, y) {
    @count = group.count(points)
    @scan = y * 2 + 1
    @found = []
    drum (count) {
        @a = group.get(points, beat)
        @b = group.get(points, (beat + 1) % count)
        @ay = group.get(a, 1) * 2
        @by = group.get(b, 1) * 2
        (((ay <= scan) ○ (by > scan)) ○○ ((by <= scan) ○ (ay > scan))) {
            @ax = group.get(a, 0)
            @under = by - ay
            @shift = (scan - ay) * (group.get(b, 0) - ax) * 2
            (under < 0) {
                under = 0 - under
                shift = 0 - shift
            }
            @x = ceiling_of((ax * 2 - 1) * under + shift, under * 2)
            @sorted = []
            @placed = no
            drum (found) {
                ((placed == no) ○ (x < beat)) {
                    sorted = group.add(sorted, x)
                    placed = yes
                }
                sorted = group.add(sorted, beat)
            }
            (placed == no) {
                sorted = group.add(sorted, x)
            }
            found = sorted
        }
    }
    out found
}

skill ceiling_of(top, under) {
    @whole = top / under
    ((top > 0) ○ (whole * under < top)) {
        out whole + 1
    }
    out whole
}

skill canvas_polygon(screen, points, value, alpha) {
    (group.count(points) < 3) {
        out none
    }
    (alpha <= 0) {
        out none
    }
    @top = screen.height
    @bottom = -1
    drum (points) {
        @y = group.get(beat, 1)
        (y < top) {
            top = y
        }
        (y > bottom) {
            bottom = y
        }
    }
    (top < 0) {
        top = 0
    }
    (bottom >= screen.height) {
        bottom = screen.height - 1
    }
    (bottom < top) {
        out none
    }
    drum (bottom - top + 1) {
        @y = top + beat
        @edges = canvas_edges(points, y)
        drum (group.count(edges) / 2) {
            @left = group.get(edges, beat * 2)
            @right = group.get(edges, beat * 2 + 1)
            blend(screen, left, y, right - left, 1, value, alpha)
        }
    }
    out none
}

skill format_name(screen) {
    (screen.format == FORMAT_RGB) { out "RGB" }
    (screen.format == FORMAT_BGR) { out "BGR" }
    out "особый ({screen.format})"
}

-- codec — сегмент TCP в байты на проводе и обратно (RFC 9293, 3.1):
-- заголовок 20 байтов, у SYN ещё опция MSS (4 байта), потом данные.
-- Числа и контрольная сумма — wire (сетевой порядок, RFC 1071); сумма — над
-- псевдозаголовком IPv4 (адреса, протокол 6, длина) и самим сегментом.
-- IP-адрес — группа из 4 чисел.
--
-- Codec {} — pack(segment, source_ip, target_ip) -> core.bytes
--     unpack(packet, source_ip, target_ip) -> segment.Segment; ShortSegment,
--         BadChecksum, BadOptions
--     segment_sum(packet, source_ip, target_ip) -> 16-битная сумма (0 у целого сегмента)
--     line — wire.Wire: сетевой порядок и сумма RFC 1071
--     options(packet, start, end) -> MSS из опций или 0; BadOptions
-- HEADER — байтов без опций; MSS_OPTION — байтов опции MSS; PROTOCOL — номер TCP в IP;
-- PSEUDO — байтов псевдозаголовка

use core.num
use core.bytes
use core.group
use segment
use tarantul.wire.wire

HEADER = 20
MSS_OPTION = 4
PROTOCOL = 6
OPTION_END = 0
OPTION_NOP = 1
OPTION_MSS = 2
PSEUDO = 12

Codec = Box {
    line = wire.Wire {}

    skill segment_sum(packet, source_ip, target_ip) {
        @pseudo = bytes.new(PSEUDO)
        drum (4) {
            bytes.set(pseudo, beat, group.get(source_ip, beat))
            bytes.set(pseudo, 4 + beat, group.get(target_ip, beat))
        }
        bytes.set(pseudo, 9, PROTOCOL)
        line.put_word(pseudo, 10, bytes.count(packet))
        out line.finish(line.sum(packet, line.sum(pseudo, 0)))
    }

    skill pack(item, source_ip, target_ip) {
        @head = HEADER
        (item.mss > 0) {
            head = HEADER + MSS_OPTION
        }
        @data = item.payload
        @packet = bytes.new(head + bytes.count(data))
        line.put_word(packet, 0, item.source_port)
        line.put_word(packet, 2, item.target_port)
        line.put_long(packet, 4, item.sequence)
        line.put_long(packet, 8, item.acknowledgment)
        bytes.set(packet, 12, (head / 4) * 16)
        bytes.set(packet, 13, item.flags)
        line.put_word(packet, 14, item.window)
        (item.mss > 0) {
            bytes.set(packet, HEADER, OPTION_MSS)
            bytes.set(packet, HEADER + 1, MSS_OPTION)
            line.put_word(packet, HEADER + 2, item.mss)
        }
        drum (bytes.count(data)) {
            bytes.set(packet, head + beat, bytes.get(data, beat))
        }
        line.put_word(packet, 16, segment_sum(packet, source_ip, target_ip))
        out packet
    }

    skill options(packet, start, end) {
        @at = start
        @found = 0
        drum (end - start + 1) {
            (at >= end) {
                leave
            }
            @kind = bytes.get(packet, at)
            (kind == OPTION_END) {
                leave
            }
            (kind == OPTION_NOP) {
                at = at + 1
            }
            ((kind == OPTION_NOP) == no) {
                ((at + 1) >= end) {
                    out error.BadOptions
                }
                @size = bytes.get(packet, at + 1)
                ((size < 2) ○○ ((at + size) > end)) {
                    out error.BadOptions
                }
                ((kind == OPTION_MSS) ○ (size == MSS_OPTION)) {
                    found = line.word(packet, at + 2)
                }
                at = at + size
            }
        }
        out found
    }

    skill unpack(packet, source_ip, target_ip) {
        (bytes.count(packet) < HEADER) {
            out error.ShortSegment
        }
        @head = (bytes.get(packet, 12) / 16) * 4
        ((head < HEADER) ○○ (head > bytes.count(packet))) {
            out error.ShortSegment
        }
        ((segment_sum(packet, source_ip, target_ip) == 0) == no) {
            out error.BadChecksum
        }
        out segment.Segment {
            source_port = line.word(packet, 0),
            target_port = line.word(packet, 2),
            sequence = line.long(packet, 4),
            acknowledgment = line.long(packet, 8),
            flags = num.and(bytes.get(packet, 13), 63),
            window = line.word(packet, 14),
            mss = options(packet, HEADER, head),
            payload = bytes.slice(packet, head, bytes.count(packet))
        }
    }
}

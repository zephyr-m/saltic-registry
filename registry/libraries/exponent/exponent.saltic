-- exponent — степени и логарифмы на core.fraction, без родных операций, как
-- синус и корень в ядре. exp: аргумент сводится к r = x − k·ln 2 (|r| ≤ ln 2 / 2),
-- ряд Тейлора, потом точное умножение на 2^k; ln 2 — двумя частями (LN2_HI
-- точно умножается на k). log: x = m · 2^e, m около единицы, ln m — ряд
-- 2·atanh((m − 1)/(m + 1)). Точность — около 1e−14 относительной; только
-- 64-битные цели (у них есть дробные).
--
-- Exponent {} — exp(x); ValueOutsideRange выше TOP
--     log(x) / log2(x) / log10(x); ValueOutsideRange при x ≤ 0
--     raised(x, y) -> x^y: целое |y| ≤ WHOLE — умножениями (повторный квадрат),
--         иначе exp(y · log |x|), у отрицательного x в целой степени — со знаком; отрицательное x в нецелой степени и 0 в
--         отрицательной — ValueOutsideRange
--     scaled(value, k) -> value · 2^k точно; reduced(x) -> [e, ln m]
--     group_first / group_second(parts) -> части reduced с известным типом
-- LN2_HI + LN2_LO — ln 2; LN10; ROOT_TWO — √2; TOP, BOTTOM — пределы exp;
-- TERMS — членов ряда; WHOLE — до какого |y| степень считается умножениями:
-- дальше ошибка основания множится на показатель, и точнее exp(y · log x)

use core.num
use core.fraction
use core.group

LN2_HI = 0.6931471803691238
LN2_LO = 0.0000000001908214929270587
LN10 = 2.302585092994046
ROOT_TWO = 1.4142135623730951
TOP = 709.78
BOTTOM = -745.0
TERMS = 26
WHOLE = 32

Exponent = Box {
    skill scaled(value, k) {
        @result = 0.0 + value
        (k > 0) {
            drum (k) {
                result = result * 2.0
            }
        }
        (k < 0) {
            drum (0 - k) {
                result = result / 2.0
            }
        }
        out result
    }

    skill exp(x) {
        (x > TOP) {
            out error.ValueOutsideRange
        }
        (x < BOTTOM) {
            out 0.0
        }
        @k = num.round_school(x / (LN2_HI + LN2_LO))
        @whole = fraction.from(k)
        @r = (x - whole * LN2_HI) - whole * LN2_LO
        @term = 1.0
        @total = 1.0
        drum (TERMS) {
            term = term * r / fraction.from(beat + 1)
            total = total + term
        }
        out scaled(total, k)
    }

    skill reduced(x) {
        @m = 0.0 + x
        @e = 0
        drum (1100) {
            (m < 2.0) {
                leave
            }
            m = m / 2.0
            e = e + 1
        }
        drum (1100) {
            ((m < 1.0) == no) {
                leave
            }
            m = m * 2.0
            e = e - 1
        }
        (m > ROOT_TWO) {
            m = m / 2.0
            e = e + 1
        }
        @s = (m - 1.0) / (m + 1.0)
        @square = s * s
        @step = s
        @total = 0.0
        drum (TERMS) {
            total = total + step / fraction.from(2 * beat + 1)
            step = step * square
        }
        out [e, 2.0 * total]
    }

    skill log(x) {
        ((x > 0.0) == no) {
            out error.ValueOutsideRange
        }
        @parts = reduced(x)
        @e = fraction.from(group_first(parts))
        out e * LN2_HI + (e * LN2_LO + group_second(parts))
    }

    skill log2(x) {
        ((x > 0.0) == no) {
            out error.ValueOutsideRange
        }
        @parts = reduced(x)
        out fraction.from(group_first(parts)) + group_second(parts) / (LN2_HI + LN2_LO)
    }

    skill log10(x) {
        out log(x) / LN10
    }

    skill raised(x, y) {
        @n = num.round_school(y)
        @whole = fraction.near(fraction.from(n), y, 0.0)
        @size = n
        (n < 0) {
            size = 0 - n
        }
        ((whole == yes) ○ (size < WHOLE)) {
            @result = 1.0
            @base = 0.0 + x
            @left = size
            drum (6) {
                (left == 0) {
                    leave
                }
                ((left % 2) == 1) {
                    result = result * base
                }
                base = base * base
                left = left / 2
            }
            (n < 0) {
                ((result > 0.0) ○○ (result < 0.0)) {
                    out 1.0 / result
                }
                out error.ValueOutsideRange
            }
            out result
        }
        (x < 0.0) {
            (whole == no) {
                out error.ValueOutsideRange
            }
            @magnitude = exp(y * log(0.0 - x))
            ((n % 2) == 0) {
                out magnitude
            }
            out 0.0 - magnitude
        }
        ((x > 0.0) == no) {
            (y > 0.0) {
                out 0.0
            }
            out error.ValueOutsideRange
        }
        out exp(y * log(x))
    }

    skill group_first(parts) {
        out 0 + group.get(parts, 0)
    }

    skill group_second(parts) {
        out 0.0 + group.get(parts, 1)
    }
}

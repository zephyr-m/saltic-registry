-- magnitude — длинная арифметика без знака: число — группа цифр по
-- основанию BASE, младшая первой; ноль — пустая группа. Основание 2^14:
-- произведение двух цифр меньше 2^28 и влезает в число даже на 29-битных
-- целях (wasm, Xtensa). Группы неизменяемы — каждый навык отдаёт новую.
--
-- Magnitude {} — навыки над группами цифр:
--     trimmed(a) -> a без старших нулей; of(n) -> цифры целого n ≥ 0
--     order(a, b) -> -1, 0, 1 — меньше, равно, больше
--     sum(a, b) / difference(a, b) -> a + b / a - b (a ≥ b)
--     scaled(a, k) -> a · k, 0 ≤ k < BASE; product(a, b) -> a · b (по столбцам:
--         цифра итога — сумма произведений цифр, перенос двумя половинками)
--     shifted(a, places) -> a · BASE^places
--     split_small(a, k) -> [частное, остаток] от деления на 0 < k < BASE
--     split(a, b) -> [частное, остаток] от деления на b ≠ 0 (столбиком по цифрам:
--         делитель сдвинут до старшего бита цифры, цифра частного — по трём
--         старшим цифрам остатка, поправка не больше двух раз)
--     digit_guess(rest, v) / row_lowered(rest, v, guess) / row_restored(digits, v) — внутри split
--     two_to(k) -> 2^k; shifted_bits(a, k) -> a · 2^k
--     cut_bits(a, k) -> [a >> k, младшие k бит a]
--     bit(a, index) -> бит index (0 — младший); bits(a) -> число значащих бит
--     small_power(k) -> 2^k для k < BITS; packed(bits_low_first) -> цифры из бит, младший первым; digit(a, index) ->
--         цифра index или 0 за краем
-- BASE, BITS — основание и бит в цифре; WORD_DIGITS — с запасом цифр у целого

use core.group

BASE = 16384
BITS = 14
WORD_DIGITS = 8

Magnitude = Box {
    skill trimmed(a) {
        @size = group.count(a)
        always {
            (size == 0) {
                leave
            }
            ((group.get(a, size - 1) == 0) == no) {
                leave
            }
            size = size - 1
        }
        (size == group.count(a)) {
            out a
        }
        out group.slice(a, 0, size)
    }

    skill of(n) {
        @digits = []
        @rest = n
        drum (WORD_DIGITS) {
            (rest == 0) {
                leave
            }
            digits = group.add(digits, rest % BASE)
            rest = rest / BASE
        }
        out digits
    }

    skill order(a, b) {
        @left = trimmed(a)
        @right = trimmed(b)
        (group.count(left) < group.count(right)) {
            out -1
        }
        (group.count(left) > group.count(right)) {
            out 1
        }
        @at = group.count(left)
        always {
            (at == 0) {
                leave
            }
            at = at - 1
            (group.get(left, at) < group.get(right, at)) {
                out -1
            }
            (group.get(left, at) > group.get(right, at)) {
                out 1
            }
        }
        out 0
    }

    skill sum(a, b) {
        @longest = group.count(a)
        (group.count(b) > longest) {
            longest = group.count(b)
        }
        @digits = []
        @carry = 0
        drum (longest) {
            @total = carry + digit(a, beat) + digit(b, beat)
            digits = group.add(digits, total % BASE)
            carry = total / BASE
        }
        (carry > 0) {
            digits = group.add(digits, carry)
        }
        out digits
    }

    skill difference(a, b) {
        @digits = []
        @borrow = 0
        drum (a) {
            @value = group.get(a, beat) - borrow - digit(b, beat)
            borrow = 0
            (value < 0) {
                value = value + BASE
                borrow = 1
            }
            digits = group.add(digits, value)
        }
        out trimmed(digits)
    }

    skill scaled(a, k) {
        (k == 0) {
            out []
        }
        @digits = []
        @carry = 0
        drum (a) {
            @entry = group.get(a, beat)
            @total = entry * k + carry
            digits = group.add(digits, total % BASE)
            carry = total / BASE
        }
        (carry > 0) {
            digits = group.add(digits, carry)
        }
        out digits
    }

    skill shifted(a, places) {
        (group.count(a) == 0) {
            out a
        }
        @digits = []
        drum (places) {
            digits = group.add(digits, 0)
        }
        out group.concat(digits, a)
    }

    skill product(a, b) {
        @left = group.count(a)
        @right = group.count(b)
        ((left == 0) ○○ (right == 0)) {
            out []
        }
        @digits = []
        @carry = 0
        drum (left + right - 1) {
            @column = beat
            @low = carry % BASE
            @high = carry / BASE
            @first_at = 0
            (column >= right) {
                first_at = column - right + 1
            }
            @last_at = column
            (last_at >= left) {
                last_at = left - 1
            }
            drum (last_at - first_at + 1) {
                @made = group.get(a, first_at + beat) * group.get(b, column - first_at - beat)
                low = low + made % BASE
                high = high + made / BASE
            }
            digits = group.add(digits, low % BASE)
            carry = high + low / BASE
        }
        out trimmed(group.concat(digits, of(carry)))
    }

    skill split_small(a, k) {
        @high = []
        @rest = 0
        @size = group.count(a)
        drum (size) {
            @current = rest * BASE + group.get(a, size - 1 - beat)
            high = group.add(high, current / k)
            rest = current % k
        }
        @digits = []
        drum (size) {
            digits = group.add(digits, group.get(high, size - 1 - beat))
        }
        out [trimmed(digits), rest]
    }

    skill split(a, b) {
        @top = trimmed(a)
        @divisor = trimmed(b)
        (order(top, divisor) < 0) {
            out [[], top]
        }
        (group.count(divisor) == 1) {
            @halves = split_small(top, group.get(divisor, 0))
            out [group.get(halves, 0), of(group.get(halves, 1))]
        }
        @lift = BITS - bits([group.get(divisor, group.count(divisor) - 1)])
        @v = shifted_bits(divisor, lift)
        @u = group.add(shifted_bits(top, lift), 0)
        @size = group.count(v)
        @steps = group.count(u) - size
        @rest = group.slice(u, steps, group.count(u))
        @high = []
        drum (steps) {
            rest = group.concat([group.get(u, steps - 1 - beat)], rest)
            @row = row_lowered(rest, v, digit_guess(rest, v))
            rest = group.get(row, 0)
            high = group.add(high, group.get(row, 1))
        }
        @digits = []
        drum (steps) {
            digits = group.add(digits, group.get(high, steps - 1 - beat))
        }
        @lowered = cut_bits(rest, lift)
        out [trimmed(digits), group.get(lowered, 0)]
    }

    skill digit_guess(rest, v) {
        @size = group.count(v)
        @head = group.get(rest, size) * BASE + group.get(rest, size - 1)
        @first = group.get(v, size - 1)
        @second = group.get(v, size - 2)
        @third = group.get(rest, size - 2)
        @guess = head / first
        (guess >= BASE) {
            guess = BASE - 1
        }
        @left = head - guess * first
        always {
            (left >= BASE) {
                leave
            }
            ((guess * second > left * BASE + third) == no) {
                leave
            }
            guess = guess - 1
            left = left + first
        }
        out guess
    }

    skill row_lowered(rest, v, guess) {
        @size = group.count(v)
        @digits = []
        @carry = 0
        @borrow = 0
        drum (size) {
            @made = guess * group.get(v, beat) + carry
            carry = made / BASE
            @value = group.get(rest, beat) - made % BASE - borrow
            borrow = 0
            (value < 0) {
                value = value + BASE
                borrow = 1
            }
            digits = group.add(digits, value)
        }
        ((group.get(rest, size) - carry - borrow) < 0) {
            out [row_restored(digits, v), guess - 1]
        }
        out [digits, guess]
    }

    skill row_restored(digits, v) {
        @back = []
        @carry = 0
        drum (v) {
            @value = group.get(digits, beat) + group.get(v, beat) + carry
            back = group.add(back, value % BASE)
            carry = value / BASE
        }
        out back
    }

    skill packed(bits_low_first) {
        @digits = []
        @value = 0
        @weight = 1
        @filled = 0
        drum (bits_low_first) {
            @entry = group.get(bits_low_first, beat)
            value = value + entry * weight
            weight = weight * 2
            filled = filled + 1
            (filled == BITS) {
                digits = group.add(digits, value)
                value = 0
                weight = 1
                filled = 0
            }
        }
        (filled > 0) {
            digits = group.add(digits, value)
        }
        out trimmed(digits)
    }

    skill two_to(k) {
        out shifted(of(small_power(k % BITS)), k / BITS)
    }

    skill shifted_bits(a, k) {
        out trimmed(shifted(scaled(a, small_power(k % BITS)), k / BITS))
    }

    skill cut_bits(a, k) {
        @place = k / BITS
        (place >= group.count(a)) {
            out [[], trimmed(a)]
        }
        @parts = split_small(group.slice(a, place, group.count(a)), small_power(k % BITS))
        @low = group.add(group.slice(a, 0, place), group.get(parts, 1))
        out [group.get(parts, 0), trimmed(low)]
    }

    skill small_power(k) {
        @value = 1
        drum (k) {
            value = value * 2
        }
        out value
    }

    skill bit(a, index) {
        @place = index / BITS
        (place >= group.count(a)) {
            out 0
        }
        @value = group.get(a, place)
        drum (index % BITS) {
            value = value / 2
        }
        out value % 2
    }

    skill bits(a) {
        @digits = trimmed(a)
        (group.count(digits) == 0) {
            out 0
        }
        @top = group.get(digits, group.count(digits) - 1)
        @count = (group.count(digits) - 1) * BITS
        always {
            (top == 0) {
                leave
            }
            top = top / 2
            count = count + 1
        }
        out count
    }

    skill digit(a, index) {
        (index < group.count(a)) {
            out group.get(a, index)
        }
        out 0
    }
}

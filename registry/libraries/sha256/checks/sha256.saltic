-- sha256 — проверка хеша и HMAC: векторы FIPS 180-4 и RFC 4231, сообщения у
-- границ блока и случайные — против Python hashlib и hmac (cases.saltic,
-- делает workbench/references/sha256.py), и миллион букв «a» (вектор стандарта).
--
-- Probe { hash } — code.decode(text) -> core.bytes; check(row) -> yes, если сошлось
-- program() -> none; TestsFailed

use io
use core.bytes
use core.group
use craft.testing
use registry.libraries.sha256.sha256
use registry.libraries.hex.hex
use registry.libraries.sha256.checks.cases

Probe = Box {
    hash = sha256.Sha256 {},
    code = hex.Hex {}

    skill check(row) {
        (group.get(row, 0) == "digest") {
            out (code.encode(hash.digest(code.decode(group.get(row, 1)))) == group.get(row, 2))
        }
        out (code.encode(hash.hmac(code.decode(group.get(row, 1)), code.decode(group.get(row, 2)))) == group.get(row, 3))
    }
}

program() {
    @suite = testing.test_new()
    @probe = Probe {}
    @hash = sha256.Sha256 {}
    @code = hex.Hex {}
    @wrong = 0
    drum (group.count(cases.CASES)) {
        @case = group.get(cases.CASES, beat)
        (probe.check(case) == no) {
            wrong = wrong + 1
            @kind = group.get(case, 0)
            @message = group.get(case, 1)
            io.show("  расхождение {kind}: {message}")
        }
    }
    @count = group.count(cases.CASES)
    io.show("sha256: случаев {count}, расхождений {wrong}")
    suite = testing.test_equal(suite, "как у Python hashlib и hmac", wrong, 0)
    suite = testing.test_equal(suite, "abc (FIPS 180-4)", code.encode(hash.digest(code.decode("616263"))), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    @million = bytes.new(1000000)
    drum (1000000) {
        bytes.set(million, beat, 97)
    }
    suite = testing.test_equal(suite, "миллион букв «a» (FIPS 180-4)", code.encode(hash.digest(million)), cases.MILLION_A)
    out testing.test_finish(suite)
}

-- sha256 — проверка хеша и HMAC: векторы FIPS 180-4 и RFC 4231, сообщения у
-- границ блока и случайные — против Python hashlib и hmac (cases.saltic,
-- делает workbench/references/sha256.py), и миллион букв «a» (вектор стандарта).
--
-- Probe { hash } — from_hex(text) -> core.bytes; check(row) -> yes, если сошлось
-- program() -> none; TestsFailed

use io
use core.str
use core.num
use core.bytes
use core.group
use craft.testing
use registry.libraries.sha256.sha256
use registry.libraries.sha256.checks.cases

Probe = Box {
    hash = sha256.Sha256 {}

    skill from_hex(text) {
        @made = bytes.new(str.bytes(text) / 2)
        drum (bytes.count(made)) {
            bytes.set(made, beat, num.hex_value(str.get(text, beat * 2)) * 16 + num.hex_value(str.get(text, beat * 2 + 1)))
        }
        out made
    }

    skill check(row) {
        (group.get(row, 0) == "digest") {
            out (hash.hex(hash.digest(from_hex(group.get(row, 1)))) == group.get(row, 2))
        }
        out (hash.hex(hash.hmac(from_hex(group.get(row, 1)), from_hex(group.get(row, 2)))) == group.get(row, 3))
    }
}

program() {
    @suite = testing.test_new()
    @probe = Probe {}
    @hash = sha256.Sha256 {}
    @wrong = 0
    drum (cases.CASES) {
        (probe.check(beat) == no) {
            wrong = wrong + 1
            @kind = group.get(beat, 0)
            @message = group.get(beat, 1)
            io.show("  расхождение {kind}: {message}")
        }
    }
    @count = group.count(cases.CASES)
    io.show("sha256: случаев {count}, расхождений {wrong}")
    suite = testing.test_equal(suite, "как у Python hashlib и hmac", wrong, 0)
    suite = testing.test_equal(suite, "abc (FIPS 180-4)", hash.hex(hash.digest(hash.of_text("abc"))), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    @million = bytes.new(1000000)
    drum (1000000) {
        bytes.set(million, beat, 97)
    }
    suite = testing.test_equal(suite, "миллион букв «a» (FIPS 180-4)", hash.hex(hash.digest(million)), cases.MILLION_A)
    out testing.test_finish(suite)
}

-- sha256 — хеш SHA-256 (FIPS 180-4) и HMAC-SHA256 (RFC 2104). Слова — обычные
-- числа с маской 32 бита (num.and/xor/сдвиги): 64-битные цели; для 29-битных
-- (ESP32, wasm) — потом на bits32. Сообщение и ответ — буферы core.bytes.
--
-- Sha256 {} — digest(message) -> 32 байта хеша
--     hmac(key, message) -> 32 байта HMAC-SHA256
--     hex(buffer) -> «ba7816bf…» — шестнадцатеричная запись строчными
--     of_text(text) -> байты текста UTF-8 как есть
--     padded(message) / words(block, at) / compress(state, block, at) /
--     rotr(x, n) / plus(a, b) — внутри
-- K — константы раундов; START — начальное состояние; MASK — 32 бита;
-- BLOCK — байт в блоке; HEX — цифры

use core.num
use core.str
use core.bytes
use core.group

MASK = 4294967295
BLOCK = 64
HEX = "0123456789abcdef"
START = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]
K = [
    1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
    3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
    3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
    2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
    666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
    2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
    1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298
]

Sha256 = Box {
    skill plus(a, b) {
        out num.and(a + b, MASK)
    }

    skill rotr(x, n) {
        out num.or(num.shift_right(x, n), num.shift_left(num.and(x, num.power2(n) - 1), 32 - n))
    }

    skill of_text(text) {
        @made = bytes.new(str.bytes(text))
        drum (str.bytes(text)) {
            bytes.set(made, beat, str.byte(text, beat))
        }
        out made
    }

    skill padded(message) {
        @size = bytes.count(message)
        @total = (size + 9 + BLOCK - 1) / BLOCK * BLOCK
        @made = bytes.new(total)
        drum (size) {
            bytes.set(made, beat, bytes.get(message, beat))
        }
        bytes.set(made, size, 128)
        @bits = size * 8
        drum (8) {
            bytes.set(made, total - 1 - beat, bits % 256)
            bits = bits / 256
        }
        out made
    }

    skill words(block, at) {
        @w = []
        drum (16) {
            @base = at + beat * 4
            w = group.add(w, ((bytes.get(block, base) * 256 + bytes.get(block, base + 1)) * 256 + bytes.get(block, base + 2)) * 256 + bytes.get(block, base + 3))
        }
        drum (48) {
            @t = beat + 16
            @x = group.get(w, t - 15)
            @y = group.get(w, t - 2)
            @low = num.xor(num.xor(rotr(x, 7), rotr(x, 18)), num.shift_right(x, 3))
            @high = num.xor(num.xor(rotr(y, 17), rotr(y, 19)), num.shift_right(y, 10))
            w = group.add(w, plus(plus(group.get(w, t - 16), low), plus(group.get(w, t - 7), high)))
        }
        out w
    }

    skill compress(state, block, at) {
        @w = words(block, at)
        @a = group.get(state, 0)
        @b = group.get(state, 1)
        @c = group.get(state, 2)
        @d = group.get(state, 3)
        @e = group.get(state, 4)
        @f = group.get(state, 5)
        @g = group.get(state, 6)
        @h = group.get(state, 7)
        drum (64) {
            @big_e = num.xor(num.xor(rotr(e, 6), rotr(e, 11)), rotr(e, 25))
            @choose = num.xor(num.and(e, f), num.and(num.xor(e, MASK), g))
            @first = plus(plus(plus(h, big_e), plus(choose, group.get(K, beat))), group.get(w, beat))
            @big_a = num.xor(num.xor(rotr(a, 2), rotr(a, 13)), rotr(a, 22))
            @major = num.xor(num.xor(num.and(a, b), num.and(a, c)), num.and(b, c))
            @second = plus(big_a, major)
            h = g
            g = f
            f = e
            e = plus(d, first)
            d = c
            c = b
            b = a
            a = plus(first, second)
        }
        out [plus(group.get(state, 0), a), plus(group.get(state, 1), b), plus(group.get(state, 2), c), plus(group.get(state, 3), d), plus(group.get(state, 4), e), plus(group.get(state, 5), f), plus(group.get(state, 6), g), plus(group.get(state, 7), h)]
    }

    skill digest(message) {
        @data = padded(message)
        @state = START
        drum (bytes.count(data) / BLOCK) {
            state = compress(state, data, beat * BLOCK)
        }
        @made = bytes.new(32)
        drum (8) {
            @word = group.get(state, beat)
            @place = beat * 4
            bytes.set(made, place, num.shift_right(word, 24))
            bytes.set(made, place + 1, num.and(num.shift_right(word, 16), 255))
            bytes.set(made, place + 2, num.and(num.shift_right(word, 8), 255))
            bytes.set(made, place + 3, num.and(word, 255))
        }
        out made
    }

    skill hmac(key, message) {
        @secret = key
        (bytes.count(key) > BLOCK) {
            secret = digest(key)
        }
        @inner = bytes.new(BLOCK + bytes.count(message))
        @outer = bytes.new(BLOCK + 32)
        drum (BLOCK) {
            @value = 0
            (beat < bytes.count(secret)) {
                value = bytes.get(secret, beat)
            }
            bytes.set(inner, beat, num.xor(value, 54))
            bytes.set(outer, beat, num.xor(value, 92))
        }
        drum (bytes.count(message)) {
            bytes.set(inner, BLOCK + beat, bytes.get(message, beat))
        }
        @middle = digest(inner)
        drum (32) {
            bytes.set(outer, BLOCK + beat, bytes.get(middle, beat))
        }
        out digest(outer)
    }

    skill hex(buffer) {
        @parts = []
        drum (bytes.count(buffer)) {
            @value = bytes.get(buffer, beat)
            parts = group.add(parts, str.slice(HEX, value / 16, value / 16 + 1))
            parts = group.add(parts, str.slice(HEX, value % 16, value % 16 + 1))
        }
        out str.join(parts, "")
    }
}
